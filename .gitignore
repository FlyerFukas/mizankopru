# Sırlar — asla depoya girmez
.env
*.key

# Yerel kurulum: gerçek şirket adları, mizan kolon düzenleri ve kurlar
# kullanıcının kendi verisidir, depoya girmez. Depo örnek dosyayla gelir;
# ilk kurulumda kopyalanır:
#     cp yapilandirma/sirketler.ornek.yaml yapilandirma/sirketler.yaml
yapilandirma/sirketler.yaml

# Üretilen veriler ve çıktılar
veri/girdi/*
veri/ara/*
veri/demo_arsiv/*
cikti/*
gunluk/*
!veri/girdi/.gitkeep
!veri/ara/.gitkeep
!cikti/.gitkeep
!gunluk/.gitkeep

# Eğitilmiş modeller: joblib/pickle biçimindedir ve pickle açmak kod
# çalıştırmaktır. Depoya girmezler; her makine kendi modelini üretir.
modeller/*.joblib
modeller/*.pkl
modeller/*.pickle

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# Ofis geçici dosyaları
~$*
.DS_Store
Thumbs.db
desktop.ini
